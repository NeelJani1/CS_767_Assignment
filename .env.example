# =====================================================================
# Intelligent Multimodal Planning & Research Agent - Environment Config
# =====================================================================

# Google Gemini API Key (Required for default provider)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY="your_google_api_key_here"
# GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Model Selection (default: gemini-1.5-flash)
# Supported options include: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL="gemini-1.5-flash"

# Optional Alternative Providers (enabled if configured in code)
# OPENAI_API_KEY="your_openai_api_key_here"
# GROQ_API_KEY="your_groq_api_key_here"

# Agent Execution Configuration
AGENT_TEMPERATURE=0.0
AGENT_VERBOSE=true
CONVERSATION_LOG_FILE="conversation_history.txt"
